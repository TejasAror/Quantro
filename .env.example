# Quantro Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets. This file contains only safe placeholders.

# =========================================================================
# AUTH MODE: Choose which authentication backend the API uses.
# -------------------------------------------------------------------------
# 1) SANDBOX / LOCAL (no external auth): Leave ALL Supabase vars empty and the
#    API runs in unauthenticated sandbox mode. Use QUANTRO_MARKET_DATA_PROVIDER=demo
#    for a fully offline paper-trading flow. (Development default.)
# 2) PRODUCTION / BETA (Supabase Auth + Postgres persistence): Set SUPABASE_URL,
#    SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and DATABASE_URL.
#    Only set these in a private `.env`, never in shared/committed files.
# =========================================================================

# ---- Supabase (required ONLY for authenticated/production mode) ----
# Example: https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable/anon key. Code also accepts SUPABASE_PUBLISHABLE_KEY as an alias.
SUPABASE_ANON_KEY=
# Secret/service-role key. Server-side ONLY. Code also accepts SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (transaction pooler recommended for Supabase).
DATABASE_URL=

# ---- Persistence / provisioning ----
# Apply bundled SQL migrations automatically on startup ("0" to disable).
QUANTRO_AUTO_MIGRATE=1
# Comma-separated ASSET=AMOUNT pairs granted to each new sandbox account.
QUANTRO_SANDBOX_INITIAL_BALANCES=USD=100000,USDT=100000,BTC=10,ETH=100

# -------------------------------------------------------------------------
# MARKET DATA PROVIDER
#   - demo  : deterministic, no-outbound, fully local paper-trading. (Dev/sandbox default)
#   - none  : no external or demo data; endpoints report unavailable/not found.
#   - okx   : OKX PUBLIC read-only market data (ticker/orderbook/trades/candles).
#             NEVER enables exchange order execution. (Safe for live-ish beta.)
# -------------------------------------------------------------------------
QUANTRO_MARKET_DATA_PROVIDER=demo
QUANTRO_MARKET_DATA_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP

# ---- OKX public endpoints (only used when provider = okx) ----
OKX_REST_BASE_URL=https://www.okx.com
OKX_WS_PUBLIC_URL=wss://ws.okx.com:8443/ws/v5/public

# =========================================================================
# FRONTEND (Vite build-time; see frontend/.env.development)
# -------------------------------------------------------------------------
# Base URL the browser uses to reach the API. Empty => same origin (Vite proxy).
VITE_API_BASE_URL=
# Backend target for the Vite dev proxy (point at local uvicorn).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# When "true", the UI offers a local sandbox signup/login that does not call
# Supabase. Development/sandbox ONLY. Keep "false" in production beta.
VITE_ENABLE_SANDBOX_AUTH=false
